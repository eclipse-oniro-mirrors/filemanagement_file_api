import("//build/ohos.gni")
import("//foundation/filemanagement/file_api/file_api.gni")

config("atomic_file_config") {
  visibility = [ ":*" ]
  include_dirs = [
    "include",
    ".",
  ]
}

ohos_shared_library("atomic_file_native") {
  cflags_cc = [ "-std=c++17" ]

  if (!use_mingw_win && !use_mac) {
    cflags = [
      "-fdata-sections",
      "-ffunction-sections",
      "-Oz",
    ]
    cflags_cc += [
      "-fvisibility-inlines-hidden",
      "-Oz",
    ]
    branch_protector_ret = "pac_ret"
    sanitize = {
      integer_overflow = true
      ubsan = true
      boundary_sanitize = true
      cfi = true
      cfi_cross_dso = true
      debug = false
    }
  }

  sources = [ "atomic_file.cpp" ]

  public_configs = [ ":atomic_file_config" ]

  include_dirs = [ "${utils_path}/filemgmt_libfs/include" ]

  deps = [
    "${utils_path}/filemgmt_libfs:filemgmt_libfs",
    "${utils_path}/filemgmt_libhilog:filemgmt_libhilog",
  ]

  external_deps = [ "hilog:libhilog" ]

  use_exceptions = true

  if (use_mingw_win) {
    defines = [ "WIN_PLATFORM" ]
  }
  if (use_mac) {
    defines = [ "IOS_PLATFORM" ]
  }

  innerapi_tags = [ "platformsdk" ]
  part_name = "file_api"
  subsystem_name = "filemanagement"
}
