import("//build/test.gni")
import("//foundation/filemanagement/file_api/file_api.gni")

ohos_unittest("atomic_file_test") {
  branch_protector_ret = "pac_ret"
  testonly = true

  module_out_path = "file_api/file_api"

  resource_config_file = "../resource/ohos_test.xml"

  include_dirs = [
    "${file_api_path}/interfaces/inner_api/native/atomic_file/include",
    "${file_api_path}/interfaces/inner_api/native/atomic_file",
    "${file_api_path}/interfaces/test/unittest/common_utils",
    "${utils_path}/filemgmt_libfs/include",
  ]

  sources = [
    "${file_api_path}/interfaces/inner_api/native/atomic_file/atomic_file.cpp",
    "${file_api_path}/interfaces/test/unittest/common_utils/ut_file_utils.cpp",
    "atomic_file/atomic_file_test.cpp",
  ]

  deps = [
    "${utils_path}/filemgmt_libfs:filemgmt_libfs",
    "${utils_path}/filemgmt_libhilog:filemgmt_libhilog",
  ]

  external_deps = [
    "bounds_checking_function:libsec_shared",
    "c_utils:utils",
    "googletest:gtest_main",
    "hilog:libhilog",
  ]

  defines = [ "private=public" ]
  use_exceptions = true
}

ohos_unittest("atomic_file_mock_test") {
  branch_protector_ret = "pac_ret"
  testonly = true

  module_out_path = "file_api/file_api"

  resource_config_file = "../resource/ohos_test.xml"

  include_dirs = [
    "${file_api_path}/interfaces/inner_api/native/atomic_file/include",
    "${file_api_path}/interfaces/inner_api/native/atomic_file",
    "${file_api_path}/interfaces/test/unittest/common_utils",
    "${file_api_path}/interfaces/test/unittest/common_mock",
    "${utils_path}/filemgmt_libfs/include",
  ]

  sources = [
    "${file_api_path}/interfaces/inner_api/native/atomic_file/atomic_file.cpp",
    "${file_api_path}/interfaces/test/unittest/common_mock/fdsan_mock.cpp",
    "${file_api_path}/interfaces/test/unittest/common_mock/mmap_mock.cpp",
    "${file_api_path}/interfaces/test/unittest/common_mock/stdio_mock.cpp",
    "${file_api_path}/interfaces/test/unittest/common_mock/stdlib_mock.cpp",
    "${file_api_path}/interfaces/test/unittest/common_mock/unistd_mock.cpp",
    "${file_api_path}/interfaces/test/unittest/common_utils/ut_file_utils.cpp",
    "atomic_file/atomic_file_mock_test.cpp",
  ]

  deps = [
    "${utils_path}/filemgmt_libfs:filemgmt_libfs",
    "${utils_path}/filemgmt_libhilog:filemgmt_libhilog",
  ]

  external_deps = [
    "bounds_checking_function:libsec_shared",
    "c_utils:utils",
    "googletest:gmock_main",
    "googletest:gtest_main",
    "hilog:libhilog",
  ]

  defines = [ "private=public" ]
  use_exceptions = true
}

group("atomic_file_unittest") {
  testonly = true
  deps = [
    ":atomic_file_mock_test",
    ":atomic_file_test",
  ]
}
