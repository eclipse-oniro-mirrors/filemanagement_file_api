import("//build/config/clang/clang.gni")
import("//build/templates/metadata/module_info.gni")
import("//foundation/filemanagement/file_api/file_api.gni")

shared_library("fs") {
  output_name = "fs"
  output_dir = target_out_dir
  output_extension = "so"

  include_dirs = [
    "${src_path}/common",
    "${src_path}/common/file_helper",
    "${src_path}/mod_fs",
    "${src_path}/mod_fs/properties",
    "${utils_path}/common/include",
    "${utils_path}/filemgmt_libfs/include",
    "//foundation/arkui/napi",
    "//foundation/arkui/napi/interfaces/inner_api",
    "//foundation/arkui/napi/interfaces/kits",
    "//foundation/arkui/napi/native_engine",
    "//third_party/node/src",
    "//base/hiviewdfx/hilog/interfaces/native/innerkits/include",
    "//third_party/libuv/include",
  ]

  sources = fs_base_src

  sources += [
    "${src_path}/mod_fs/properties/lseek.cpp",
    "${src_path}/mod_fs/properties/read_text.cpp",
    "${src_path}/mod_fs/properties/symlink.cpp",
  ]

  cflags_cc = [
    "-std=c++17",
    "-fexceptions",
    "-frtti",
  ]
  defines = [ "PREVIEW_LINUX" ]

  configs -= [
    "//build/config/compiler:no_exceptions",
    "//build/config/compiler:no_rtti",
  ]

  deps = [
    ":fs_info",
    "${file_api_path}/utils/filemgmt_libhilog:filemgmt_libhilog",
    "${file_api_path}/utils/filemgmt_libn:filemgmt_libn",
    "//third_party/libuv:uv",
    "//third_party/bounds_checking_function:libsec_shared",
    "//foundation/arkui/napi:ace_napi",
    "//base/hiviewdfx/hilog/interfaces/native/innerkits:libhilog",
  ]
}

generate_module_info("fs_info") {
  module_name = "fs"
  module_type = "lib"
  module_source_dir = target_out_dir
  module_install_name = "fs"
  module_output_extension = ".so"
  install_enable = false
  module_label = ":fs"
}
